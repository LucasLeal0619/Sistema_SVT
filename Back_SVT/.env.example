APP_NAME=SVT
APP_ENV=local
# Gere com: php artisan key:generate
# Nunca compartilhe o .env nem use a mesma APP_KEY em outro ambiente.
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs: use "daily" com retenção para evitar laravel.log único sem limite.
# Em produção: LOG_LEVEL=warning (ou error) e APP_DEBUG=false.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco MySQL (XAMPP desta maquina) ---
# Ajuste PORTA, USUARIO e SENHA conforme o XAMPP/MySQL daqui.
# Porta comum: 3306. Em alguns PCs aparece 3307 ou 3308 no XAMPP.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=SVT
DB_USERNAME=root
DB_PASSWORD=

# Auth da API é Sanctum (token no MySQL). Sessão file só cobre rotas web residuais.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Prefira "database" (tabela cache já migrada) para reduzir escrita no disco C:.
# Alternativas: file | array | redis (só se já houver Redis no ambiente).
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Token Sanctum expira após N minutos (padrão: 480 = 8h). Deixe vazio para não expirar.
SANCTUM_TOKEN_EXPIRATION=480

# Monitoramento de disco (php artisan sgp:check-disk / scripts/windows/check-disk.ps1)
# SGP_HEALTH_DISKS=C:,D:
# SGP_DISK_WARN_PERCENT=15
# SGP_DISK_WARN_GB=15
# SGP_DISK_CRIT_PERCENT=8
# SGP_DISK_CRIT_GB=8

# Em production, seeders de demo só rodam com ALLOW_DEMO_SEED=true
# ALLOW_DEMO_SEED=false

# Sistemas de Apoio (URLs públicas — sem senhas)
# SISTEMA_APOIO_SEI_URL=https://seisenac.df.senac.br/sei/
# SISTEMA_APOIO_SIG_URL=https://cloud.plataforma.senac.br/
# SISTEMA_APOIO_SIGIN_URL=https://sigin.df.senac.br/
# SISTEMA_APOIO_SENAC_URL=https://www.df.senac.br

